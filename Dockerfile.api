FROM python:3.13-slim
WORKDIR /app
COPY backend/requirements.txt .
# mmh3 (a fastembed dependency) has no prebuilt wheel for slim Linux, so compile it, then drop the toolchain
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && pip install --no-cache-dir -r requirements.txt \
    && apt-get purge -y build-essential && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*
COPY backend/ .
COPY samples/ /samples/
# Pre-download the embedding model and reranker so the first request isn't slow
RUN python -c "from fastembed import TextEmbedding; from fastembed.rerank.cross_encoder import TextCrossEncoder; TextEmbedding('BAAI/bge-small-en-v1.5'); TextCrossEncoder('Xenova/ms-marco-MiniLM-L-6-v2')"
EXPOSE 8002
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8002"]
